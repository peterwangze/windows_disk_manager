<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 磁盘空间管理器" Width="1130" Height="800" MinWidth="780" MinHeight="490"
        WindowStartupLocation="CenterScreen" Background="#F3F6F8"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#203345"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="WhenTrue"/>
    <Style TargetType="Button" x:Key="ToolButton">
      <Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#AABFC7"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style TargetType="Button" x:Key="Link">
      <Setter Property="Foreground" Value="#0B666D"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Plate" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#DEEEEF"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="Background" Value="#CCE5E6"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <HierarchicalDataTemplate x:Key="Row" ItemsSource="{Binding Children}">
      <Grid Height="34" Margin="9,0,5,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="108"/><ColumnDefinition Width="140"/>
          <ColumnDefinition Width="98"/><ColumnDefinition Width="64"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <CheckBox x:Name="PickBox" Tag="pick" AutomationProperties.AutomationId="SelectItem" AutomationProperties.Name="{Binding PickLabel}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding CanPick}"
                    Visibility="{Binding HasPickBox,Converter={StaticResource WhenTrue}}" IsChecked="{Binding Marked,Mode=TwoWay}"
                    ToolTip="{Binding PickLabel}"/>
        <Grid Grid.Column="1" Margin="{Binding Indent}" ToolTip="{Binding Tip}" ClipToBounds="True">
          <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ToggleButton Grid.Column="0" Width="22" Height="26" Focusable="False" Cursor="Hand"
              AutomationProperties.Name="展开或收起"
              Visibility="{Binding HasItems,RelativeSource={RelativeSource AncestorType=TreeViewItem},Converter={StaticResource WhenTrue}}"
              IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource AncestorType=TreeViewItem},Mode=TwoWay}">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Grid Background="Transparent">
                  <Path x:Name="Caret" Data="M 1,1 L 5,5 L 1,9" Stroke="#536679" StrokeThickness="1.5"
                      HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Caret" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                </Trigger></ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                     Foreground="{Binding IconBrush}" Text="{Binding Icon}" IsHitTestVisible="False"/>
          <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}"
                     FontWeight="{Binding Weight}" Foreground="{Binding NameBrush}"/>
          <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#986122" FontSize="11"
                     Margin="4,0,5,0" Text="{Binding FlagLabel}"/>
        </Grid>
        </Grid>
        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding SizeText}" FontWeight="SemiBold"
                   FontFamily="Segoe UI, Microsoft YaHei UI" ToolTip="{Binding BytesTip}"/>
        <Grid Grid.Column="2" Margin="17,0,0,0" Visibility="{Binding ShowShare,Converter={StaticResource WhenTrue}}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="53"/></Grid.ColumnDefinitions>
          <Border Height="7" VerticalAlignment="Center" Background="#E6EEF0" CornerRadius="3">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Filled}"/><ColumnDefinition Width="{Binding Unfilled}"/></Grid.ColumnDefinitions>
              <Border Background="{Binding BarBrush}" CornerRadius="3"/></Grid>
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding PercentText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#486075" FontFamily="Segoe UI"/>
        </Grid>
        <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding LengthText}"
                   Foreground="#556A7C" FontFamily="Segoe UI, Microsoft YaHei UI" ToolTip="{Binding LogicalTip}"/>
        <Button Grid.Column="4" Tag="reveal" Style="{StaticResource Link}" Visibility="{Binding CanReveal,Converter={StaticResource WhenTrue}}"
                AutomationProperties.AutomationId="RevealInExplorer" AutomationProperties.Name="{Binding ActionText}"
                Content="{Binding ActionText}" ToolTip="{Binding RevealTip}" Padding="7,3" Margin="4,0,0,0" VerticalAlignment="Center"/>
        <Button Grid.Column="4" Tag="more" Style="{StaticResource Link}" Visibility="{Binding IsMore,Converter={StaticResource WhenTrue}}"
                AutomationProperties.AutomationId="LoadMore" Content="加载" Padding="7,3" Margin="4,0,0,0" VerticalAlignment="Center"/>
      </Grid>
    </HierarchicalDataTemplate>
    <Style TargetType="TreeViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="IsExpanded" Value="{Binding IsOpen,Mode=TwoWay}"/>
      <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <StackPanel>
            <Border x:Name="Backdrop" Background="White" BorderBrush="#F0F3F4" BorderThickness="0,0,0,1">
              <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/>
            </Border>
            <ItemsPresenter x:Name="ChildrenHost"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ChildrenHost" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger SourceName="Backdrop" Property="IsMouseOver" Value="True"><Setter TargetName="Backdrop" Property="Background" Value="#F2F8F8"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Backdrop" Property="Background" Value="#DCEFF0"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24,18,24,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,13">
      <DockPanel>
        <Button x:Name="CheckUpdates" AutomationProperties.AutomationId="CheckUpdates" Content="检查更新" DockPanel.Dock="Right"
                Style="{StaticResource ToolButton}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="Stamp" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#5D7182" FontSize="12"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Windows 磁盘空间管理器" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="AppVersion" AutomationProperties.AutomationId="AppVersion" FontSize="13" Margin="10,3,0,0"
                     VerticalAlignment="Center" Foreground="#4C6B7A"/>
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="UpdateNotice" AutomationProperties.AutomationId="UpdateNotice" Visibility="Collapsed"
                 Margin="1,6,0,0" Foreground="#855616" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
    <WrapPanel x:Name="DriveCards" Grid.Row="1" Margin="0,0,0,10"/>
    <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <WrapPanel>
        <Button x:Name="Refresh" AutomationProperties.AutomationId="Refresh" Content="刷新" ToolTip="重新扫描（F5）" Style="{StaticResource ToolButton}"/>
        <Button x:Name="CancelScan" AutomationProperties.AutomationId="CancelScan" Content="取消扫描" Visibility="Collapsed" Style="{StaticResource ToolButton}"/>
        <TextBlock x:Name="SelectionCount" AutomationProperties.AutomationId="SelectionCount" Margin="7,0,11,0" VerticalAlignment="Center" Foreground="#354F60" Text="已选 0 项"/>
        <Button x:Name="ClearSelection" AutomationProperties.AutomationId="ClearSelection" Content="清空选择" Style="{StaticResource ToolButton}" IsEnabled="False"/>
        <Button x:Name="RecycleSelection" AutomationProperties.AutomationId="RecycleSelection" Content="移入回收站" Style="{StaticResource ToolButton}" IsEnabled="False"/>
        <Button x:Name="RecycleReport" AutomationProperties.AutomationId="RecycleReport" Content="查看处理结果" Visibility="Collapsed" Style="{StaticResource ToolButton}"/>
        <TextBlock x:Name="RecycleSummary" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#46616E"/>
      </WrapPanel>
      <TextBlock x:Name="ScanStatus" AutomationProperties.AutomationId="ScanStatus" Margin="1,7,0,0" Foreground="#476777" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="3" Background="White" BorderBrush="#D6E1E5" BorderThickness="1" CornerRadius="7">
      <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#DCE4E8" BorderThickness="0,0,0,1" Background="#E9F0F2" CornerRadius="7,7,0,0">
          <Grid Margin="9,0,22,0" TextElement.Foreground="#4D6374" TextElement.FontSize="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="108"/><ColumnDefinition Width="140"/>
              <ColumnDefinition Width="98"/><ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="文件夹 / 文件" Margin="30,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="占用空间 ↓" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="占父目录" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="文件大小" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="跳转" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <TreeView x:Name="UsageTree" AutomationProperties.AutomationId="UsageTree" Grid.Row="1" BorderThickness="0" Background="White"
            ItemTemplate="{StaticResource Row}" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Pixel"/>
        <StackPanel x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
          <TextBlock Text="暂无磁盘快照" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="扫描完成后，可以在这里展开磁盘、查看文件并管理空间。" Margin="0,7,0,0" Foreground="#637A89"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#F8FAFB" BorderBrush="#E8EFF0" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
          <TextBlock x:Name="Selection" Margin="13,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#425D70"/>
        </Border>
      </Grid>
    </Border>
    <TextBlock Grid.Row="4" Margin="1,9,0,0" FontSize="11" Foreground="#576C7A" TextWrapping="Wrap"
        Text="目录合计按文件路径累计，硬链接可能重复计入。目录链接跳过，受限和未知项目仅计入已读部分。磁盘用量取自系统。"/>
  </Grid>
</Window>
